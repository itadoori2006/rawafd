{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "rawafd-pages",
  "main": "pages/_worker.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
